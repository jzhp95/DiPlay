<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Window backgrounds must be resource references: Android 9 and older read windowBackground with
    getResourceId(), so a literal colour there leaves the window with no background at all and
    dialogs draw over the screen behind them (#640, #617).
    -->
    <color name="window_background_dark">#20272E</color>
    <color name="window_background_light">#D3DBE5</color>
    <color name="dialog_background_dark">#24282E</color>
    <color name="dialog_background_light">#DAE2EB</color>
</resources>
